{
  "name": "clearbreath",
  "version": "1.0.0",
  "description": "GenAI assistant that helps Indian families navigate winter smog with low-emission routines, indoor air hacks and sustainable alternatives.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "node scripts/build.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/gloock": "^5.3.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
